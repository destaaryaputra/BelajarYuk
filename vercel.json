{
  "version": 2,
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.1"
    }
  },
  "routes": [
    { "src": "/assets/(.*)", "dest": "/public/assets/$1" },
    { "src": "/js/(.*)", "dest": "/public/js/$1" },
    { "src": "/pages/(.*)", "dest": "/public/pages/$1" },
    { "src": "/components/(.*)", "dest": "/public/components/$1" },
    { "src": "/uploads/(.*)", "dest": "/public/uploads/$1" },
    { "src": "/public/assets/(.*)", "dest": "/public/assets/$1" },
    { "src": "/public/js/(.*)", "dest": "/public/js/$1" },
    { "src": "/favicon.ico", "dest": "/public/assets/favicon.svg" },
    { "src": "/api/(.*)", "dest": "/api/index.php" },
    { "src": "/(.*)", "dest": "/api/index.php" }
  ],
  "env": {
    "APP_ENV": "production",
    "APP_BASE_PATH": ""
  }
}
